LECTERN_DATA_DIR=
LECTERN_LOG_LEVEL=info
LECTERN_TELEMETRY=false
LECTERN_EGRESS_ALLOW=

# Network interface for the production server (adapter-node). Localhost-only
# by default since the API has no auth; set 0.0.0.0 only behind a proxy/auth.
HOST=127.0.0.1

# Optional: extra provider presets surfaced on the onboarding screen.
# JSON array of { id, label, endpoint, model, headers?, help? } entries.
# Merged with the built-in presets; same `id` overrides a built-in.
# Example:
# LECTERN_EXTRA_PRESETS=[{"id":"acme","label":"Acme GW","endpoint":"https://gw.acme.example/v1","model":"acme-7b"}]
LECTERN_EXTRA_PRESETS=

# Optional: id of the preset selected by default in onboarding.
LECTERN_DEFAULT_PRESET=

# Optional: GitLab token fallback per host. Used when no keychain entry exists.
# Env-var name is derived from the host: gitlab.example.com -> LECTERN_GITLAB_TOKEN_GITLAB_EXAMPLE_COM.
# LECTERN_GITLAB_TOKEN_GITLAB_EXAMPLE_COM=
