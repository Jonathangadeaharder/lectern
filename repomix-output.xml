[data-theme="dark"] {
	/* Surfaces (HSL channels) */
	--surface-0: 220 13% 9%;
	--surface-1: 220 13% 12%;
	--surface-2: 220 13% 16%;
	--surface-3: 220 13% 20%;

	/* Borders */
