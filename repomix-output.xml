		const result = parsePrUrl('https://github.com/owner/repo/pull/7/');
		expect(result).toEqual({
			platform: 'github',
			host: 'github.com',
			owner: 'owner',
			repo: 'repo',
			prNumber: 7
		});
	});

	it('parses GitLab merge request URL', () => {
		const result = parsePrUrl('https://gitlab.com/owner/repo/-/merge_requests/10');
		expect(result).toEqual({
			platform: 'gitlab',
			host: 'gitlab.com',
			owner: 'owner',
			repo: 'repo',
