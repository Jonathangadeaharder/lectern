	interface Props {
		question: Question;
		onsubmit: (code: string) => Promise<void>;
		onskip?: () => void;
		graded?: { rawScore?: number; verdict?: string; feedback?: string };
	}

	let { question, onsubmit, onskip, graded }: Props = $props();

	let code = $state(question?.originalCode ?? '');
	let submitting = $state(false);

