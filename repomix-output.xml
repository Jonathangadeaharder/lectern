<script lang="ts">
	let confirmData = $state('');
	let confirmKeys = $state('');
	let dataBusy = $state(false);
	let keysBusy = $state(false);
	let dataMsg = $state('');
	let keysMsg = $state('');

	async function clearData(): Promise<void> {
