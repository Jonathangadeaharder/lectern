		try {
			const res = await fetch('/api/data/clear', { method: 'DELETE' });
			dataMsg = res.ok ? 'Session data cleared.' : 'Failed to clear data.';
			confirmData = '';
		} catch {
			dataMsg = 'Request failed.';
		} finally {
			dataBusy = false;
