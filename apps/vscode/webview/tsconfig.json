{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": ["svelte"],
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"$lib/*": ["../../../src/lib/*"]
		}
	},
	"include": ["**/*.ts", "**/*.svelte", "../../../src/lib/client/mr/**/*", "../../../src/lib/shared/mr/**/*"]
}
